# PostgreSQL connection (used for LangGraph checkpoints + users/trips tables)
DATABASE_URL=postgresql://user:password@localhost:5432/tripcrew_db

# LLM
GROQ_API_KEY=your_groq_api_key
# Groq periodically retires older models — check console.groq.com/docs/models
# for the current list if this one ever 404s.
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Flight + hotel search
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
TAVILY_API_KEY=your_tavily_api_key
DEFAULT_ORIGIN_IATA=DAC

# Auth (generate a random secret, e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
